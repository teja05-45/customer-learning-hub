# Backend (backend/.env) — copy with: cp .env.example backend/.env
# Any value here is optional; the defaults run a fully seeded demo.
# Production-safe defaults: an empty database, no demo entry.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/clh.db
SEED_ON_STARTUP=false
SEED_DEMO_DATA=false
DEMO_MODE=false
# Set true only when served over HTTPS; the Docker demo stack is plain HTTP.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Failed sign-ins allowed per client address and per account before a 429.
# Set LOGIN_MAX_FAILURES=0 to disable the limiter (demo only).
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=300
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Demo instance: enable all three together.
# SEED_ON_STARTUP=true
# SEED_DEMO_DATA=true
# DEMO_MODE=true

# Frontend (frontend/.env) — only needed when the API is not on /api via the proxy.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
